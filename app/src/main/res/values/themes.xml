<?xml version="1.0" encoding="utf-8"?>
<!--
  The app UI itself is Compose, but Material Components views (the LoadingIndicator
  on the video screen) require a Material theme on the activity, so this wraps the
  framework theme. Dark is forced because Off is a dark-only design.
-->
<resources>
    <style name="Theme.Off" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/off_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!--
          Android 12+ splash. The icon is now adaptive, so the system masks it to
          the device's icon shape and fills it with our own background instead of
          drawing a white box behind a square bitmap. The icon background is forced
          transparent so no OEM can reintroduce that box.
        -->
        <item name="android:windowSplashScreenBackground">@color/off_window_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
