<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon. Without this, Android treats the launcher icon as a legacy
  bitmap and draws its own white background behind it on the Android 12+ splash
  screen — a white box around a square icon, which is what was showing.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
